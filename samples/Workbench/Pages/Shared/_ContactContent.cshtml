@model Workbench.Pages.ContactModel

<h3>Contact Engineering Support</h3>

@if (Model.Submitted)
{
    <div id="contact-success" style="background: #064e3b; color: #a7f3d0; padding: 1rem; border-radius: 6px; margin-top: 1rem;">
        <h4>Thank you, @Model.Name!</h4>
        <p>Your message has been received.</p>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="background: #450a0a; color: #fecaca; padding: 0.75rem; border-radius: 4px; border: 1px solid #dc2626; margin-bottom: 1rem;">
            @Model.ErrorMessage
        </div>
    }

    <form method="post" action="/contact" vx-post vx-target="#contact" id="contact-form">
        @Html.AntiForgeryToken()
        <div style="margin-bottom: 1rem;">
            <label style="display: block; margin-bottom: 0.25rem;">Name</label>
            <input type="text" name="name" value="@Model.Name" required style="width: 100%; box-sizing: border-box;" />
        </div>
        <div style="margin-bottom: 1rem;">
            <label style="display: block; margin-bottom: 0.25rem;">Message</label>
            <textarea name="message" rows="4" required style="width: 100%; box-sizing: border-box; background: #0f172a; color: #fff; border: 1px solid #334155; border-radius: 4px; padding: 0.5rem;">@Model.Message</textarea>
        </div>
        <button type="submit">Send Message</button>
    </form>
}
