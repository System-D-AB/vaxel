@model (int Id, string Title)

<form method="post" action="/proposals/@Model.Id/save" vx-post vx-target="#prop-@Model.Id">
    @Html.AntiForgeryToken()
    <label style="display: block; margin-bottom: 0.5rem;">Edit Proposal #@Model.Id Title:</label>
    <input type="text" name="title" value="@Model.Title" style="width: 80%;" />
    <button type="submit">Save</button>
    <a href="/proposals/@Model.Id/cancel" vx-get style="margin-left: 0.5rem; color: #94a3b8;" vx-target="#prop-@Model.Id">Cancel</a>
</form>
