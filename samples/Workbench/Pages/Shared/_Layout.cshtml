<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>vaxel Workbench</title>
    <vaxel-antiforgery />
    <style>
        :root { --bg: #0f172a; --card: #1e293b; --text: #f8fafc; --primary: #38bdf8; --border: #334155; }
        body { margin: 0; font-family: system-ui, -apple-system, sans-serif; background: var(--bg); color: var(--text); }
        header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 2rem; background: var(--card); border-bottom: 1px solid var(--border); }
        nav a { color: var(--primary); text-decoration: none; margin-right: 1.5rem; font-weight: 500; }
        main { display: grid; grid-template-columns: 1fr 320px; gap: 1.5rem; padding: 2rem; }
        .pane { background: var(--card); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--border); min-height: 300px; }
        .rail { background: var(--card); padding: 1.5rem; border-radius: 8px; border: 1px solid var(--border); }
        .notices { margin-bottom: 1rem; }
        .notice { padding: 0.75rem 1rem; border-radius: 6px; margin-bottom: 0.5rem; }
        .notice.refusal { background: #450a0a; color: #fecaca; border: 1px solid #dc2626; }
        .notice.success { background: #064e3b; color: #a7f3d0; border: 1px solid #059669; }
        button, input, .btn { padding: 0.5rem 0.75rem; border-radius: 4px; border: 1px solid var(--border); background: #0f172a; color: #fff; text-decoration: none; display: inline-block; font-size: 0.9rem; }
        button, .btn { background: var(--primary); color: #000; font-weight: 600; cursor: pointer; border: none; }
    </style>
</head>
<body vx-sse="/_vaxel/stream">
    <header>
        <div>
            <h2 style="margin: 0; display: inline-block;">⚡ vaxel Workbench</h2>
        </div>
        <nav>
            <a href="/?tab=submissions" vx-get vx-target="#pane" vx-vals-tab="submissions">Submissions</a>
            <a href="/?tab=proposals" vx-get vx-target="#pane" vx-vals-tab="proposals">Proposals</a>
            <a href="/?tab=settings" vx-get vx-target="#pane" vx-vals-tab="settings">Settings</a>
            <a href="/contact" vx-get vx-target="#pane">Contact Form</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span style="color: #94a3b8; margin-left: 1rem;">@User.Identity.Name (@(User.IsInRole("Approver") ? "Approver" : "Viewer"))</span>
                <a href="/login?handler=Logout" style="margin-left: 0.5rem; color: #ef4444;">Sign Out</a>
            }
            else
            {
                <a href="/login" style="margin-left: 1rem;">Sign In</a>
            }
        </nav>
    </header>

    <div id="notices" class="notices" vx-region style="padding: 0 2rem; margin-top: 1rem;">
        <!-- Notice region for toasts, confirmations, and Patch.Refused -->
    </div>

    <main>
        <section id="pane" class="pane" vx-region>
            @RenderBody()
        </section>

        <aside id="rail" class="rail" vx-region>
            <h3 style="margin-top: 0;">Live Activity</h3>
            <div id="live-updates" vx-region>
                <p style="color: #94a3b8; font-size: 0.9rem;">Connected to live updates...</p>
            </div>
        </aside>
    </main>

    <script src="/_vaxel/vaxel.js"></script>
</body>
</html>
