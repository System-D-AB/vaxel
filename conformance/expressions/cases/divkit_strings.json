  { "name": "divkit_str_interpolation_ternary_one", "expression": "You have @{count} @{count == 1 ? 'item' : 'items'}.", "state": { "count": 1 }, "expect": { "ok": true, "value": "You have 1 item." } },
  { "name": "divkit_str_interpolation_plain_text", "expression": "No expressions here.", "state": {}, "expect": { "ok": true, "value": "No expressions here." } },
